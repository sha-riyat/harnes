{
  "name": "harnes-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "ctx": "cargo build -p harnes-ctx -p harnes-e2e",
    "ctx:release": "cargo build -p harnes-ctx -p harnes-e2e --release",
    "app": "npm run ctx && tauri dev",
    "app:build": "npm run ctx:release && tauri build",
    "site": "esbuild ../site/src/main.ts --bundle --format=esm --minify --log-level=warning --outfile=../site/main.js"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "cva": "1.0.0-beta.4",
    "solid-js": "^1.9.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
