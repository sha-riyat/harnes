{
  "name": "harnes-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "ctx": "cargo build -p harnes-ctx -p harnes-e2e",
    "ctx:release": "cargo build -p harnes-ctx -p harnes-e2e --release",
    "app": "npm run ctx && tauri dev",
    "app:build": "npm run ctx:release && tauri build",
    "readme:art": "esbuild scripts/readme-art.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/readme-art.mjs && node node_modules/.cache/readme-art.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
