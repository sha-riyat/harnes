{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "medium",
  "language": "french",
  "includeCoAuthoredBy": false,
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebSearch",
      "WebFetch",
      "Agent",
      "Skill",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git stash*)",
      "Bash(git add*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(node *)",
      "Bash(nvm *)",
      "Bash(python *)",
      "Bash(pytest*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "PowerShell(Get-*)",
      "PowerShell(Test-Path*)",
      "PowerShell(npm *)",
      "PowerShell(npx *)",
      "PowerShell(pnpm *)",
      "PowerShell(node *)",
      "PowerShell(nvm *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git add*)",
      "mcp__harnes-ctx",
      "Bash(curl -s*)",
      "mcp__harnes-e2e"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "PowerShell(git commit*)",
      "PowerShell(git push*)",
      "PowerShell(git merge*)",
      "PowerShell(git rebase*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "PowerShell(git push --force*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(Remove-Item -Recurse -Force C:\\*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "ponytail@ponytail": true,
    "context-mode@context-mode": false
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "harnes-ctx",
    "harnes-e2e"
  ]
}
